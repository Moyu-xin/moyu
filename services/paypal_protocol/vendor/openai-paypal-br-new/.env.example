# paypal-pay example environment
# Copy this file to .env and replace placeholder values.
# Do not commit your real .env; it may contain proxy/API credentials.

# -----------------------------------------------------------------------------
# Proxy
# -----------------------------------------------------------------------------
# Enable outbound proxy for CLI/Web jobs. Use either PAYPAL_PROXY_URL or pool.
PAYPAL_PROXY_ENABLED=1
PAYPAL_PROXY_URL=http://user:pass@host:port
# PAYPAL_PROXY_POOL=http://user1:pass1@host1:port,http://user2:pass2@host2:port

# -----------------------------------------------------------------------------
# Recommended production browser runtime: local headless Chromium
# -----------------------------------------------------------------------------
# Pure Python/protocol modes are not fully complete for risk-control signals.
# Prefer headless or roxy in production.
PAYPAL_FINGERPRINT_SOURCE=headless
PAYPAL_DATADOME_MODE=headless
PAYPAL_MTR_RUNTIME=headless
PAYPAL_RISK_SIGNALS_MODE=headless

PAYPAL_HEADLESS=1
PAYPAL_HEADLESS_MAX_CONCURRENCY=1
PAYPAL_DATADOME_HEADLESS_WAIT_SECONDS=12
PAYPAL_MTR_HEADLESS_WAIT_SECONDS=20
PAYPAL_RISK_HEADLESS_WAIT_SECONDS=12
# Allowlist learning is disabled by default; the completed learned rules are
# frozen into the built-in headless policy. Enable only when re-training routes.
PAYPAL_HEADLESS_ALLOWLIST_LEARNING=0
PAYPAL_HEADLESS_ALLOWLIST_CACHE_ENABLED=0

# Production default: no debug files, no raw request/response body dumps.
PAYPAL_HEADLESS_DEBUG=0
PAYPAL_HEADLESS_OPTIMIZED_DEBUG=0
PAYPAL_HEADLESS_DEBUG_RAW=0
PAYPAL_HEADLESS_OPTIMIZED_DEBUG_RAW=0
# Enable only when troubleshooting:
# PAYPAL_HEADLESS_DEBUG=1
# PAYPAL_HEADLESS_DEBUG_DIR=debug/headless

# -----------------------------------------------------------------------------
# Optional RoxyBrowser runtime
# -----------------------------------------------------------------------------
# To use Roxy, switch the four runtime variables above from headless to roxy.
PAYPAL_ROXY_API_KEY=replace_with_roxy_api_key
PAYPAL_ROXY_API_HOST=127.0.0.1
PAYPAL_ROXY_API_PORT=50000
PAYPAL_ROXY_HEADLESS=1
PAYPAL_ROXY_FORCE_OPEN=0
PAYPAL_ROXY_CLOSE_BEFORE_OPEN=0
PAYPAL_ROXY_FINGERPRINT_FALLBACK=random
PAYPAL_DATADOME_ROXY_WAIT_SECONDS=12
PAYPAL_MTR_ROXY_WAIT_SECONDS=20
PAYPAL_RISK_ROXY_WAIT_SECONDS=12

# Production default: do not create/delete Roxy teams/workspaces automatically.
PAYPAL_ROXY_FORCE_TEMP_WORKSPACE=0
PAYPAL_ROXY_AUTO_CREATE_WORKSPACE=0
PAYPAL_ROXY_DELETE_AUTO_WORKSPACE=0
# If Roxy Local API cannot discover the active workspace, pin an existing one:
# PAYPAL_ROXY_WORKSPACE_ID=123456
# PAYPAL_ROXY_PROJECT_ID=123456

# -----------------------------------------------------------------------------
# SMS provider
# -----------------------------------------------------------------------------
# Manual mode: leave SMSBOWER_ENABLED=0 and pass --phone on CLI / input in Web UI.
SMSBOWER_ENABLED=0
SMSBOWER_API_KEY=replace_with_smsbower_api_key
SMSBOWER_WAIT_SECONDS=30
# PAYPAL_SMS_PROVIDER=smsbower

# -----------------------------------------------------------------------------
# Web UI
# -----------------------------------------------------------------------------
PAYPAL_WEB_PRODUCTION=0
PAYPAL_WEB_COOKIE_SECURE=0
PAYPAL_WEB_ALLOW_DEBUG_LOGS=0
PAYPAL_WEB_MAX_ACTIVE_JOBS=4
PAYPAL_WEB_MAX_ACTIVE_JOBS_PER_DEVICE=2
PAYPAL_WEB_JOB_RETENTION_SECONDS=86400
PAYPAL_WEB_OTP_TIMEOUT_SECONDS=1800
PAYPAL_WEB_MAX_LOG_LINES=300

# -----------------------------------------------------------------------------
# Traffic capture / diagnostics
# -----------------------------------------------------------------------------
# Keep disabled in production. Captures are written under captures/ when enabled.
PAYPAL_TRAFFIC_RECORD=0
# PAYPAL_TRAFFIC_RECORD_DIR=captures/program-paypal-local

# -----------------------------------------------------------------------------
# Runtime fallback behavior
# -----------------------------------------------------------------------------
# 1 = fallback to protocol/python paths if browser runtime fails; 0 = strict.
PAYPAL_ROXY_RUNTIME_FALLBACK=1
PAYPAL_HEADLESS_RUNTIME_FALLBACK=1

# -----------------------------------------------------------------------------
# Optional challenge / captcha values
# -----------------------------------------------------------------------------
# PAYPAL_HCAPTCHA_TOKEN=
# PPS_PAYPAL_HCAPTCHA_TOKEN=
