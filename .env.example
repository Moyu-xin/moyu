# Environment key overrides config.json and requires a restart when changed.
# CHATGPT2API_AUTH_KEY=moyu666

STORAGE_BACKEND=json
CHATGPT2API_HOST=127.0.0.1
CHATGPT2API_PORT=8000

# Docker first-run values. The initial key is ignored after runtime/config.json exists.
CHATGPT2API_INITIAL_AUTH_KEY=moyu666
CHATGPT2API_BIND_ADDRESS=127.0.0.1

# Optional runtime locations.
# CHATGPT2API_CONFIG_FILE=/app/runtime/config.json
# CHATGPT2API_DATA_DIR=/app/runtime/data
# CHATGPT2API_LOG_DIR=/app/runtime/logs
